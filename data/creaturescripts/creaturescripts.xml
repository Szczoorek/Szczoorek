<?xml version="1.0" encoding="UTF-8"?>
<!--
	FRAGMENT - do not drop this file in as-is if your server already has a
	creaturescripts.xml. Merge the <event> lines below into your existing
	file instead. Each "name" is referenced from the matching monster's
	<script><event name="..."/></script> block.
-->
<creaturescripts>
	<event name="RustbeardAI" script="dungeons/rustbeard_ai.lua"/>
	<event name="GrixAI" script="dungeons/grix_ai.lua"/>
	<event name="BlackscaleAI" script="dungeons/blackscale_ai.lua"/>
	<event name="MalacharAI" script="dungeons/malachar_ai.lua"/>
	<event name="OpheliaAI" script="dungeons/ophelia_ai.lua"/>
	<event name="VarekAI" script="dungeons/varek_ai.lua"/>
	<event name="FlameseerAI" script="dungeons/flameseer_ai.lua"/>
	<event name="FenrirAI" script="world/fenrir_ai.lua"/>
	<event name="VaultTrashDeath" script="bounties/vault_trash_death.lua"/>
	<event name="CathedralTrashDeath" script="bounties/cathedral_trash_death.lua"/>
	<event name="TrainingDummyDeath" script="quests/training_dummy_death.lua"/>
	<event name="GrimtoothAI" script="raid/grimtooth_ai.lua"/>
	<event name="TwinsAI" script="raid/twins_ai.lua"/>
	<event name="SlagmawAI" script="raid/slagmaw_ai.lua"/>
	<event name="AshgraveAI" script="raid/ashgrave_ai.lua"/>
	<event name="IgnarethAI" script="raid/ignareth_ai.lua"/>

	<!-- Renown: docks the killer's Renown for an open-world player kill.
	     Unlike every other line in this file, this event is NOT attached
	     via a monster's <script> block - it must be registered on every
	     PLAYER at login instead. See docs/design/renown_and_pvp.md for
	     the one-line addition your server's existing login script needs. -->
	<event name="RenownPvpPenalty" script="pvp/renown_penalty.lua"/>
</creaturescripts>
